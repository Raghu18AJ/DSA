#include <bits/stdc++.h> 
bool matrixGame(vector<vector<int>> &mat)
{
    // Write your code here
    int size = mat.size();
    for(int k = 0;k<size;k++){
        for(int i = 0;i < size;i++){
            int sum = 0;
            for(int j = 0;j < size;j++){
                sum += mat[k][j]*mat[j][i];
            }
            if(sum != mat[k][i]){
                return false;
            }

            
        }
    }
    return true;
}

